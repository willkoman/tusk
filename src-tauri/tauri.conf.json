{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tusk",
  "version": "0.11.2",
  "identifier": "com.willko.tusk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tusk",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MkUzMENGMDU2ODNEQTgKUldTb1BXZ0Z6ekF1U1IvUTUwdEZMUXcrSjFDajh5QkxvYXB3clgrY1ZZZTVXNk5wdW9NblZ4MEUK",
      "endpoints": [
        "https://github.com/willkoman/tusk/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Fast, native, lightweight SQL client. Postgres-first.",
    "longDescription": "Tusk is a desktop SQL workbench for PostgreSQL, DuckDB, SQLite, MySQL and SQL Server: a schema-aware editor, streaming results with in-grid editing, visual EXPLAIN, an ERD, import and export, backup and restore, and a built-in updater. No Electron, no JVM, no telemetry.",
    "homepage": "https://github.com/willkoman/tusk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libssl3", "libdbus-1-3"],
        "desktopTemplate": "linux/tusk.desktop"
      },
      "rpm": {
        "depends": ["libssl.so.3()(64bit)", "libdbus-1.so.3()(64bit)"],
        "desktopTemplate": "linux/tusk.desktop"
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
